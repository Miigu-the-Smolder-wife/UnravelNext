// Depth of field (A5 lens integral; FEATURES_GAME 4.1, DepthOfField.cpp): shared definitions.
// A pixel's signed circle-of-confusion radius rho (px, negative in front of the plane of focus) puts it in the radius
// octave c = 0 for |rho| <= 4 and ceil(log2(|rho| / 4)) above, and it is gathered at pyramid level c (texels 2^c px), where
// its disk is at most 4 texels wide in radius: sharp pixels stay at full resolution, blurred ones are read coarsely. A
// level-c texel holds its octave's pixels only: colour sum / 4^c and area share alpha (A), and its shape (S): the
// luminance-weighted centroid's offset from the texel centre (px), the spread w = sqrt(6 variance) (px; a pixel's own
// variance 1/6 included: one pixel 1, a uniform texel 2^c) and rho alpha.
#ifndef UNX_DOF_COMMON_HLSLI
#define UNX_DOF_COMMON_HLSLI

#define DOF_TILE 32u
#define DOF_CATEGORIES 8u
#define DOF_MAX_RADIUS 512.0f  // 4 x 2^7: the largest octave's radius (larger radii are clamped and counted)
#define DOF_OFFSETS 113u        // lattice offsets with |o|^2 <= 36 (radius 6 texels), by distance

uint dofCategory(float rho)
{
    const float a = abs(rho);
    return a <= 4.0f ? 0u : min(DOF_CATEGORIES - 1u, (uint)ceil(log2(a * 0.25f)));
}

// The level-0 kernel (a source pixel of radius rho <= 4.5 onto the receiver pixel at integer offset o): a pixel is a
// uniform square of radiance (the box its value averages), the lens spreads it over a disk of radius rho, the receiver
// averages over its own square: W(o; rho) = E_{t in the disk} tent(o.x - t.x) tent(o.y - t.y), tent(u) = max(0, 1 - |u|)
// (box x box). W(0; 0) = 1: a source at rho = 0 is its pixel; any rho > 0 spreads (a pixel keeps 80 % at rho = 1/4 px,
// 62 % at 1/2). Tabulated at rho = 0, 1/4, .., 4.5 over |o.x| >= |o.y|, 0..5 (index x (x + 1) / 2 + y; the lattice
// sum of every row is 1), linear in rho.
