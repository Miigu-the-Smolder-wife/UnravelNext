    { 0.0156554, 0.0157339, 0.0157198, 0.0157186, 0.0157194, 0.0157190, 0.0157177, 0.0157196, 0.0155273, 0.0111780, 0.0135993, 0.0125005, 0.0079808, 0.0017005, 0.0000112, 0.0018248, 0.0011350, 0.0001489, 0.0000000, 0.0000000, 0.0000000 } };
float dofPixelWeight(int2 o, float rho)
{
    const uint2 a = uint2(abs(o));
    const uint x = max(a.x, a.y), y = min(a.x, a.y);
    if (x > 5u) return 0;
    const uint i = x * (x + 1) / 2 + y;
    const float r = clamp(rho * 4.0f, 0.0f, 18.0f);
    const uint j = min((uint)r, 17u);
    return lerp(kDofPixelKernel[j][i], kDofPixelKernel[j + 1][i], r - j);
}

