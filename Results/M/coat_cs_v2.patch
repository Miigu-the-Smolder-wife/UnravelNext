+        /// <summary>A9 layers of a Unity material: URP Complex Lit's clear coat (_ClearCoatMask, _ClearCoatSmoothness) as the
+        /// 1.5 coat (glaze, varnish, lacquer); _UnravelWetness (any shader, 0..1) as the 1.33 water film of a wet surface
+        /// (smoothness _UnravelWetSmoothness, default 0.95). One coat per material: a wet coated material keeps the film.</summary>
+        MaterialDesc Layers(Material m, MaterialDesc d)
+        {
+            d.ClearcoatIor = 1.5f;
+            if (d.MaterialClass != (uint)MaterialClass.Standard) return d;
+            float wet = Float(m, "_UnravelWetness", 0), coat = m.IsKeywordEnabled("_CLEARCOAT") || m.IsKeywordEnabled("_CLEARCOATMAP") ? Float(m, "_ClearCoatMask", 0) : 0;
+            if (Map(m, "_ClearCoatMap")) Reports.Add(m.name + ": clear coat map is not read (the coat's cover and smoothness are the material's constants)");
+            if (wet > 0)
