+                if (coat > 0) Reports.Add(m.name + ": wet and clear-coated: the water film is drawn (one coat per material)");
+                d.Clearcoat = Mathf.Clamp01(wet);
+                d.ClearcoatRoughness = 1 - Mathf.Clamp01(Float(m, "_UnravelWetSmoothness", 0.95f));
+                d.ClearcoatIor = 1.33f;
+            }
+            else if (coat > 0)
